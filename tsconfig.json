{
    "compilerOptions": {
        // Project structure
        "paths": {"*": ["./*"]},

        // Module system
        "module": "ESNext",
        "target": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,

        // Type checking
        "strict": true,
        // Obsidian's bundled declarations currently disagree with their own interfaces; keep checking project source while skipping dependency declaration internals.
        "skipLibCheck": true,

        // Type definitions
        "lib": ["DOM", "ESNext"],
    },
    "include": ["src/**/*.ts", "e2e/**/*.ts"],
    "exclude": ["node_modules"]
}
