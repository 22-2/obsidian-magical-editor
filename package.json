{
  "name": "@22-2/obsidian-magical-editor",
  "version": "1.0.18",
  "type": "module",
  "description": "A reusable inline MarkdownView editor wrapper for Obsidian plugins",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "release": "release-it",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "editor",
    "markdown"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@playwright/test": "^1.63.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "monkey-around": "^3.0.0",
    "obsidian-e2e-toolkit": "https://github.com/22-2/obsidian-e2e-toolkit/releases/download/1.2.3/obsidian-e2e-toolkit-1.2.3.tgz",
    "playwright": "^1.63.0",
    "release-it": "^21.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "obsidian": ">=1.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "obsidian-e2e-toolkit"
    ]
  }
}
