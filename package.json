{
  "name": "obsidian-magical-editor",
  "version": "0.1.0",
  "description": "A reusable inline MarkdownView editor wrapper for Obsidian plugins",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "editor",
    "markdown"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "electron": "^40.8.0",
    "monkey-around": "^3.0.0",
    "obsidian": "^1.12.3",
    "obsidian-e2e-toolkit": "github:22-2/obsidian-e2e-toolkit#0.1.7",
    "playwright": "^1.58.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "obsidian-magical-editor": "file:"
  }
}
