{
  "name": "@22-2/obsidian-magical-editor",
  "version": "1.0.17",
  "type": "module",
  "description": "A reusable inline MarkdownView editor wrapper for Obsidian plugins",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "editor",
    "markdown"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "electron": "^41.4.0",
    "esbuild": "^0.28.0",
    "monkey-around": "^3.0.0",
    "obsidian-e2e-toolkit": "https://github.com/22-2/obsidian-e2e-toolkit/releases/download/1.2.3/obsidian-e2e-toolkit-1.2.3.tgz",
    "playwright": "^1.59.1",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "obsidian": ">=1.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "obsidian-e2e-toolkit"
    ]
  }
}
