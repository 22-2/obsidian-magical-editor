{
  "name": "obsidian-magical-editor",
  "version": "0.1.0",
  "description": "A reusable inline MarkdownView editor wrapper for Obsidian plugins",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "editor",
    "markdown"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "obsidian": "*"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "obsidian": "^1.12.3",
    "obsidian-typings": "4.105.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
