{
  "name": "@22-2/obsidian-magical-editor",
  "version": "1.0.6",
  "type": "module",
  "description": "A reusable inline MarkdownView editor wrapper for Obsidian plugins",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "editor",
    "markdown"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "electron": "^41.0.3",
    "esbuild": "^0.27.4",
    "monkey-around": "^3.0.0",
    "obsidian-e2e-toolkit": "github:22-2/obsidian-e2e-toolkit#1.0.2",
    "playwright": "^1.58.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "obsidian": ">=1.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "obsidian-e2e-toolkit"
    ]
  }
}
