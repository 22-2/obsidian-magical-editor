{
  "git": {
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "requireUpstream": true,
    "commit": true,
    "commitMessage": "bump version to ${version}\n\n- Update package version and changelog for ${version}",
    "tagName": "${version}",
    "push": true
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits"
      },
      "infile": "CHANGELOG.md"
    }
  },
  "hooks": {
    "before:init": "pnpm check-types && pnpm build"
  }
}
